# Frontend environment
#
# Copy to .env and adjust if your backend runs somewhere other than the default.
#
# Note what is NOT here any more: no VITE_GEMINI_API_KEY, and no Supabase keys.
# Anything prefixed VITE_ is compiled into the JavaScript bundle and readable by
# anyone who opens the browser's dev tools, so a secret must never be one.
# The Gemini key and the database credentials now live in backend/.env, on the
# server, where the browser cannot reach them.

VITE_API_URL=http://localhost:8000/api/v1
