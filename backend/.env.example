# ── Database ────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → Session pooler.
# Swap the driver prefix to postgresql+psycopg:// and keep sslmode=require.
DATABASE_URL=postgresql+psycopg://postgres.PROJECTREF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-you-deploy-anything
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI ──────────────────────────────────────────────────────────────────────
# Server-side only. Never prefix this with VITE_ — that would ship it to the browser.
#
# Google retires model names, and the failure is confusing: generateContent
# answers 404 while the models list endpoint still advertises the name. Both
# lines below have been retired once already — text-embedding-004 first, then
# gemini-2.5-flash ("no longer available to new users"). If the assistant starts
# answering from records only while the key is valid, check the API log for a
# 404 and pick a current name from
# https://ai.google.dev/gemini-api/docs/models before assuming the key is wrong.
#
# gemini-flash-latest looks like the way to avoid ever repinning, and is not:
# it resolves to whatever is newest, which is what is busiest. Measured on a
# free key with a realistic prompt, three calls each, it returned 503 every
# time, as did 3.8-flash, while 3.7-flash answered all three in 3-4 seconds.
# Pin a specific model and repin when it retires.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# ── CORS ────────────────────────────────────────────────────────────────────
# Which origins the browser may call this API from. In production this must
# list the deployed frontend's exact origin — scheme and host, no trailing
# slash and no path. A mismatch here is the most common deployment failure:
# the browser blocks the request, and the server log shows nothing at all,
# because the request never reached it.
#   local:      http://localhost:5173,http://127.0.0.1:5173
#   deployed:   https://e-panchayat.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Seed ────────────────────────────────────────────────────────────────────
# Password given to every demo account created by `python -m app.seed`.
SEED_DEFAULT_PASSWORD=Panchayat@2026
