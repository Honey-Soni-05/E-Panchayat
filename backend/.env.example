# ── Database ────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → Session pooler.
# Swap the driver prefix to postgresql+psycopg:// and keep sslmode=require.
DATABASE_URL=postgresql+psycopg://postgres.PROJECTREF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-you-deploy-anything
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI ──────────────────────────────────────────────────────────────────────
# Server-side only. Never prefix this with VITE_ — that would ship it to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Seed ────────────────────────────────────────────────────────────────────
# Password given to every demo account created by `python -m app.seed`.
SEED_DEFAULT_PASSWORD=Panchayat@2026
